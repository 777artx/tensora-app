{
  "name": "tensora-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pulse:generate": "node scripts/pulse/generate-wallets.mjs",
    "pulse:fund-plan": "node scripts/pulse/fund-plan.mjs",
    "pulse:dry": "node scripts/pulse/run-pulse.mjs --dry",
    "pulse:run": "node scripts/pulse/run-pulse.mjs",
    "pulse:distribute": "node scripts/pulse/distribute.mjs",
    "pulse:check": "node scripts/pulse/check-wallets.mjs",
    "pulse:loop": "node scripts/pulse/loop-pulse.mjs",
    "fleet:local": "npx -y tsx scripts/pulse/trade-fleet.mts --local",
    "fleet:plan": "npx -y tsx scripts/pulse/trade-fleet.mts --onchain --plan",
    "fleet:trade": "npx -y tsx scripts/pulse/trade-fleet.mts --onchain --yes",
    "fleet:loop:local": "npx -y tsx scripts/pulse/loop-fleet.mts --local --cycles 1",
    "fleet:loop:plan": "npx -y tsx scripts/pulse/loop-fleet.mts --onchain --plan",
    "fleet:loop": "npx -y tsx scripts/pulse/loop-fleet.mts --onchain --yes",
    "fleet:loop:forever": "npx -y tsx scripts/pulse/loop-fleet.mts --onchain --yes --forever",
    "ops:backing": "node scripts/ops/backing-monitor.mjs",
    "ops:backing:watch": "node scripts/ops/backing-monitor.mjs --watch",
    "stress:dry": "npx -y tsx scripts/stress/order-book-stress.mts --dry",
    "stress:contend": "npx -y tsx scripts/stress/order-book-stress.mts --dry --multiproc 3",
    "stress:live": "npx -y tsx scripts/stress/order-book-stress.mts --live --yes"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.44.0",
    "@privy-io/server-auth": "^1.32.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "^15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.56.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
